{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default Config with vcpkg",
      "description": "Default configuration using vcpkg manifest mode",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "FILEPATH",
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows (MSVC)",
      "description": "Windows build using Visual Studio / MSVC",
      "inherits": "default",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
      }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux GCC",
      "description": "Build on Linux using GCC and Ninja",
      "inherits": "default",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-linux",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "windows-clang",
      "displayName": "Windows Clang (Ninja)",
      "description": "Windows build using Clang (clang-cl) and Ninja",
      "inherits": "default",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
      }
    },
    {
      "name": "ninja-multi-vcpkg",
      "displayName": "Ninja Multi-Config with vcpkg",
      "description": "Ninja Multi-Config build using vcpkg",
      "inherits": "default",
      "generator": "Ninja Multi-Config"
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-debug",
      "displayName": "Debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug"
    },
    {
      "name": "windows-msvc-release",
      "displayName": "Release",
      "configurePreset": "windows-msvc",
      "configuration": "Release"
    },
    {
      "name": "windows-clang-release",
      "displayName": "Windows Clang Release",
      "configurePreset": "windows-clang"
    },
    {
      "name": "linux-gcc-release",
      "displayName": "Linux GCC Release",
      "configurePreset": "linux-gcc",
      "configuration": "Release"
    }
  ]
}
